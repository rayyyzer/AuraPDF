{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AuraPDF",
  "mainBinaryName": "AuraPDF",
  "version": "0.9.0",
  "identifier": "com.aurapdf.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8443",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuraPDF",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' blob: data: asset: http://asset.localhost; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests;"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rayyyzer/AuraPDF/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "bin"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format (PDF)",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
